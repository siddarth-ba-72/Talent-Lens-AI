# Copy to .env and fill in. Every setting is read by app/config.py.

# --- Runtime ---------------------------------------------------------------
# dev: /docs enabled, non-Secure cookies. Anything else is production.
# Unset on Vercel production/preview deployments means prod.
APP_ENV=dev

# --- Datastores (defaults match docker-compose.yml) -------------------------
DATABASE_URL=postgresql://talentlens:talentlens@localhost:5432/talentlens
MONGODB_URI=mongodb://root:root@localhost:27017/?authSource=admin
MONGODB_DATABASE=talentlens

# --- Auth ------------------------------------------------------------------
# At least 32 characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Google sign-in (optional). A redirect URI is the origin you open the app on + /oauth/google/callback.
# List every origin you sign in from, comma-separated (the first is the default), and register each
# one exactly (scheme, host, port, path) in Google Cloud Console. With the Vite dev server, add :5173.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:9000/oauth/google/callback,http://localhost:5173/oauth/google/callback

# --- LLM -------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Candidate sourcing ------------------------------------------------------
# A platform whose required setting is missing is shown as "Not configured" in the UI.
# Required for GitHub: a personal access token (no scopes needed for public data).
GITHUB_TOKEN=
# Optional but recommended: raises Stack Overflow from 300 to 10,000 requests/day.
# Register an app at https://stackapps.com/apps/oauth/register (the key is not a secret).
STACKEXCHANGE_KEY=
# Required for GitLab: a personal access token with the read_api scope.
GITLAB_TOKEN=
# Optional: raises Hugging Face rate limits.
HF_TOKEN=
# Optional but recommended: raises OpenAlex's free daily allowance ($0.10 -> $1).
OPENALEX_API_KEY=
# Required for crates.io, whose usage policy asks for a contact in the User-Agent.
# Use a team or ops address, not a personal one.
SOURCING_CONTACT=
